BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=postgresql://content_mill:content_mill@localhost:5432/content_mill
POSTGRES_PASSWORD=content_mill
S3_PORT=9090
S3_BUCKET=content-mill
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# Серверный ключ общего каталога голосов
LUMEAN_API_KEY=

# HTTPS origin внешнего MCP за обратным прокси (при локальном запуске пусто)
MCP_PUBLIC_ORIGIN=

# Серверная генерация сценариев. Достаточно одного ключа.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# codex — Codex CLI, claude — Claude Code CLI. Пустое значение сохраняет режим HTTP API.
CONTENT_MILL_SCRIPT_PROVIDER=codex
# Применяется в режиме HTTP API.
CONTENT_MILL_SCRIPT_MODEL=

# Раскадровка и монтаж. codex — GPT-6.2-Astra, polza — Claude Opus 5.5.
CONTENT_MILL_MONTAGE_PROVIDER=codex

# Ключ Polza AI для генерации кадров и доступа к Claude Opus 5.5.
POLZA_API_KEY=

# Синхронизация губ видимого ведущего по выбору при сборке
HEYGEN_API_KEY=

# UUID аккаунта владельца админ-панели
MILL_ADMIN_USER_ID=

# Локальная OpenMotion Studio. По умолчанию Compose собирает закреплённый Git-коммит.
OPENMOTION_PORT=4173
# OPENMOTION_BUILD_CONTEXT=../openmotion-work/openmotion-local

# Local multilingual speech recognition for reels (size or local model path).
CONTENT_MILL_WHISPER_MODEL=small
